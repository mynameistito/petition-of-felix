{
  "name": "petition-of-felix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply petition-of-felix-pulse --local",
    "db:migrate:remote": "wrangler d1 migrations apply petition-of-felix-pulse --remote",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "^7.12.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
